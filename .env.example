# Закупщик — переменные окружения. Реальные значения только в .env (не коммитить).
# Compose лежит в infra/, поэтому запуск: cd infra && docker compose --env-file ../.env up -d

# Стенд
DOMAIN=zakupki-robot.systemtool.ru
DEBUG=false
APP_SECRET_KEY=change_me_openssl_rand_hex_32

# БД: shared-infra Postgres 16, своя база и роль без прав владельца
DATABASE_URL=postgresql+psycopg://zakupshchik_app:change_me@shared-infra-postgres:5432/zakupshchik
# Только для миграций Alembic (владелец схемы); приложение работает под DATABASE_URL
DATABASE_OWNER_URL=postgresql+psycopg://zakupshchik_owner:change_me@shared-infra-postgres:5432/zakupshchik

# LLM через OmniRoute (OpenAI-совместимый шлюз)
LLM_BASE_URL=http://omniroute:20128/v1
LLM_API_KEY=change_me
LLM_MODEL_MAIN=zakupshchik-main
LLM_MODEL_CHEAP=zakupshchik-cheap

# Telegram: бот для менеджеров и алерты о падении стенда
TELEGRAM_BOT_TOKEN=change_me
TELEGRAM_ALERT_CHAT_ID=change_me

# Выход с российским IP для сбора с площадок (туннель рабочего ПК).
# Нужен только стенду на VPS вне России. Туннель слушает 127.0.0.1 хоста, контейнеры ходят через proxy-relay
# (профиль tunnel): up -d --profile tunnel. Цель ретранслятора: 1080 — домашний ПК (основной), 1081 — ноутбук
# В России оставить пустым.
PROXY_URL=socks5h://172.31.250.1:11080
RELAY_TARGET=127.0.0.1:1080
# Интервал цикла сбора, минут
COLLECT_INTERVAL_MIN=5

# Учётка жюри на стенде (выдаём в форме сдачи)
JURY_LOGIN=jury
JURY_PASSWORD=change_me
